# Compose environment template. Copy to `.env` (gitignored) and fill in.
#
#   cp .env.example .env
#
# Every variable below feeds either compose itself (image tags, ports) or is
# forwarded into the gateway as a SHARAM_* env var. Sharam.toml is NOT used
# inside containers — figment falls back to env vars when the file is absent.

# ---------------------------------------------------------------------------
# Public site
# ---------------------------------------------------------------------------
# Use `:80` for plain HTTP on localhost (default) or a real domain like
# `sharam.example.com` to let Caddy auto-provision Let's Encrypt certs.
SITE_ADDRESS=:80

# Public origin the browser sees. Used by gateway CORS. With Caddy proxying
# /api on the same origin as the SPA, this is just the site root.
FRONTEND_ORIGIN=http://localhost

# Host port mappings for Caddy. Change if 80/443 are taken.
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443

# HS256 secret for Sharam-issued session JWTs. MUST be at least 32 bytes of
# random data. Rotating it invalidates every live session at once. Used by
# both Google sign-in and email/password — the same token shape comes out
# of either path.
# Generate with:  openssl rand -base64 48
SHARAM_GATEWAY__SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_BYTES_OF_RANDOM_DATA

# ---------------------------------------------------------------------------
# Google OAuth (required — gateway refuses to start without these)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_WITH_YOUR_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost/api/auth/callback/google

# ---------------------------------------------------------------------------
# SurrealDB
# ---------------------------------------------------------------------------
# Control-plane namespace + database. Per-tenant namespaces are created on
# demand by the gateway and don't appear here.
SURREAL_NS=system
SURREAL_DB=control
# Default matches Sharam.example.toml so host-mode dev works without
# editing anything. Rotate before any production deploy and update the
# gateway's [surrealdb].password (Sharam.toml) or SHARAM_SURREALDB__PASSWORD
# (--profile app) to match.
SURREAL_PASS=root

# ---------------------------------------------------------------------------
# RustFS (S3-compatible, used for receipt proofs)
# ---------------------------------------------------------------------------
# Compose interpolates the same pair into RustFS (RUSTFS_ACCESS_KEY/SECRET_KEY)
# and the gateway (SHARAM_STORAGE__ACCESS_KEY_ID/SECRET_ACCESS_KEY), so the
# two cannot drift. For host-mode dev, Sharam.toml's [storage] credentials
# must match these values too — the in-repo Sharam.example.toml ships with
# `rustfs`/`rustfs` for that reason.
RUSTFS_USER=rustfs
RUSTFS_PASS=rustfs
STORAGE_BUCKET=sharam-proofs
STORAGE_REGION=us-east-1
# Console log verbosity inside the rustfs container. `warn` is the upstream
# default; flip to `info` or `debug` when chasing storage-side bugs.
RUSTFS_LOG_LEVEL=warn

# ---------------------------------------------------------------------------
# SMTP (required for `--profile app` — gateway refuses to start without these)
# ---------------------------------------------------------------------------
# Used to send invite emails. For dev (no profile), the gateway runs on the
# host and reads Sharam.toml's [smtp] block instead — these env vars only
# apply to the `--profile app` gateway container. Point at a real provider
# (SES, Postmark, Mailgun, etc.) — mailhog is dev-only.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
# "starttls" (587), "tls" (465), or "plain" (no encryption — dev only).
SMTP_ENCRYPTION=starttls
SMTP_FROM_EMAIL=no-reply@sharam.example.com
SMTP_FROM_NAME=Sharam
# Public origin baked into invite links. Usually matches FRONTEND_ORIGIN.
APP_BASE_URL=http://localhost

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
RUST_LOG=info,tower_http=debug
